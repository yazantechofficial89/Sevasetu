# Server Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# ========================================================
# RAZORPAY PAYMENT GATEWAY (https://dashboard.razorpay.com)
# ========================================================
# 1. Sign up on Razorpay & complete KYC
# 2. Switch from "Test Mode" to "Live Mode" in top navbar
# 3. Go to: Account & Settings -> API Keys -> Generate Key
# For REAL payments: Key ID starts with 'rzp_live_...'
# For TEST sandbox: Key ID starts with 'rzp_test_...'
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Organization & Merchant Details for Razorpay Checkout & UPI QR
MERCHANT_NAME=SevaSetu Foundation
MERCHANT_UPI_ID=7011906923@ptaxis

# Google Gemini API Key (Model: gemini-3.8-flash, get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
