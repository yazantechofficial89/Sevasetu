{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{*.html,**/*.html,*.png,*.css,*.js,*.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api"
    }
  ]
}
